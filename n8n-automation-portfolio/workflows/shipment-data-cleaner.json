    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst summary = {};\n\nfor (const item of items) {\n\n  const carrier = item.json.carrier;\n  const status = item.json.status;\n\n  if (!summary[carrier]) {\n\n    summary[carrier] = {\n      carrier: carrier,\n      delivered: 0,\n      in_transit: 0,\n      failed: 0\n    };\n\n  }\n\n  if (status === \"delivered\") {\n    summary[carrier].delivered++;\n  }\n\n  else if (status === \"in-transit\") {\n    summary[carrier].in_transit++;\n  }\n\n  else {\n    summary[carrier].failed++;\n  }\n}\n\nreturn Object.values(summary).map(row => ({\n  json: row\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
