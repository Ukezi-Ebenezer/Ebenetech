    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const shipmentId = $json.id;\n\nconst carrier = $json.name || \"\";\n\nconst validStatuses = [\n  \"delivered\",\n  \"in-transit\",\n  \"failed\"\n];\n\n// Create demo status values\nlet statusOptions = [\n  \"delivered\",\n  \"in-transit\",\n  \"failed\",\n  \"returned\" // invalid on purpose\n];\n\nlet status =\n  statusOptions[shipmentId % 4];\n\nlet errors = [];\n\n// Missing shipment ID\nif (!shipmentId) {\n  errors.push(\"Missing shipment ID\");\n}\n\n// Missing carrier\nif (!carrier) {\n  errors.push(\"Missing carrier\");\n}\n\n// Invalid status\nif (!validStatuses.includes(status)) {\n  errors.push(\"Invalid status\");\n}\n\n// Duplicate Detection\nconst workflowData =\n  $getWorkflowStaticData('global');\n\nif (!workflowData.seenIds) {\n  workflowData.seenIds = [];\n}\n\nif (\n  workflowData.seenIds.includes(\n    shipmentId\n  )\n) {\n  errors.push(\n    \"Duplicate shipment ID\"\n  );\n}\nelse {\n  workflowData.seenIds.push(\n    shipmentId\n  );\n}\n\nreturn {\n  shipment_id: shipmentId,\n  carrier: carrier,\n  weight_kg: shipmentId * 5,\n  destination_country: \"Nigeria\",\n  status: status.toLowerCase(),\n  _error: errors.join(\" | \")\n};"
      },
